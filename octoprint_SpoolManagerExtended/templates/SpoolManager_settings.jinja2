
<form id="spmx-settings_spoolmanager" class="form-horizontal" >
    <h3>Spool Manager <small>{{ _('Version') }}: <span data-bind="text: pluginSettings.installed_version"></span></small></h3>
    <div class="tabbable"> <!-- Only required for left/right tabs -->
        <ul class="nav nav-tabs" id="spmx-spoolmanger-settings-tab">
            <li class="active"><a href="#spmx-tab-spool-General" data-toggle="tab">General</a></li>
            <li><a href="#spmx-tab-spool-Temperature" data-toggle="tab">Temperature</a></li>
            <li><a href="#spmx-tab-spool-QR-Code" data-toggle="tab">QR - Code</a></li>
            <li><a href="#spmx-tab-spool-Template" data-toggle="tab">Template</a></li>
            <li><a href="#spmx-tab-spool-Export-Import" data-toggle="tab">Export / Import</a></li>
            <li><a href="#spmx-tab-spool-Storage" data-toggle="tab">Storage</a></li>
            <li><a href="#spmx-tab-spool-MQTT" data-toggle="tab">MQTT</a></li>
            <li><a href="#spmx-tab-spool-OctoScale" data-toggle="tab">OctoScale</a></li>
            <li><a href="#spmx-tab-spool-U1RFID" data-toggle="tab">U1 RFID</a></li>
            <li><a href="#spmx-tab-spool-SpoolmanDB" data-toggle="tab">SpoolmanDB</a></li>
            <li><a href="#spmx-tab-spool-Debugging" data-toggle="tab">Debugging</a></li>
        </ul>
        <div class="tab-content">
            <!-- GENERAL - TAB -->
            <div class="tab-pane active" id="spmx-tab-spool-General">
                <div class="control-group">
                    <label class="control-label">Currency symbol</label>
                    <div class="controls">
                        <input type="text" class="input-mini text-center" data-bind="value: pluginSettings.currencySymbol">
                    </div>
                </div>
                <hr/>
                <h4>Display units</h4>
                <div class="control-group">
                    <label class="control-label">Filament length unit</label>
                    <div class="controls">
                        <select class="input-small" data-bind="value: pluginSettings.lengthUnit">
                            <option value="mm">mm</option>
                            <option value="cm">cm</option>
                            <option value="m">m</option>
                        </select>
                        <span class="help-inline">Used for the length fields in the spool edit dialog.</span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">Weight unit</label>
                    <div class="controls">
                        <select class="input-small" data-bind="value: pluginSettings.weightUnit">
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                        </select>
                        <span class="help-inline">Used for the weight fields in the spool edit dialog.</span>
                    </div>
                </div>
                <hr/>
                <h4>Edit dialog</h4>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.defaultViewModeSimple" > Open the spool editor in <strong>Simple view</strong> by default.
                        </label>
                        <span class="help-block">
                            <small>Simple view hides advanced fields (temperatures, flow rate, QR/serial/batch, dates, purchase &amp; cost).
                            The per-browser toggle in the editor overrides this default.</small>
                        </span>
                    </div>
                </div>
                <hr/>
                <h4>Notifications</h4>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.reminderSelectingSpool" > Reminder for verifying the selected spool.
                        </label>
                    </div>
                </div>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.warnIfSpoolNotSelected" > Warn, if no spool is selected.
                        </label>
                    </div>
                </div>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.warnIfFilamentNotEnough" > Warn, if filament is not enough for print job
                        </label>
                        <span class="help-inline">Hint: It is only working, if the spool contains values for these fields: <br>
                            <code>diameter</code>, <code>density</code>, <code>total weight</code>!</span>
                    </div>
                </div>

                <hr/>
                <h4>Performance</h4>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.performanceLazyLoadSpoolSelectorData" > Lazy load spool selector data (spool list is fetched on first "select spool" dialog open instead of on page load).
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.performanceLazyLoadSpoolTable" > Lazy load spool table (table is fetched on first SpoolManager tab open instead of on page load).
                        </label>
                        <span class="help-inline"><small>Reduces load on less powerful machines / large databases. A page reload is required after changing these options.</small></span>
                    </div>
                </div>

                <hr/>
                <h4>Remaining check</h4>
                <div class="control-group">
                    <label class="control-label">Enter safety buffer (e.g. PTFE Tube length)</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" min="0" class="input-mini text-right" data-bind="value: pluginSettings.safetyLength" >
                            <span class="add-on">mm</span>
                        </div>
                    </div>
                </div>
<!--
                <h4>Default Catalogs</h4>
                <div>
                    You can enter default values for the selection lists in the Spool edit dialog.<br/>
                    Please be aware, if you change the values in the following textareas it is not reflected to existing values!
                </div>
                <div class="control-group">
                    <label class="control-label">Vendors</label>
                    <div class="controls">
                        <textarea id="spmx-vendorsTextArea"
                                  rows="5"
                                  style="width:90%"
                                  >
JANBEX
MatterHackers
Prusament
Proto Pasta
                        </textarea>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">Materials</label>
                    <div class="controls">
                        <textarea id="spmx-materialTextArea"
                                  rows="5"
                                  style="width:90%"
                                  >
PLA;	1.24
PLA_plus;	1.24
ABS;	1.04
PETG;	1.27
NYLON;	1.52
TPU;	1.21
PC;	    1.3
Wood;	1.28
Carbon;	1.3
PC_ABS;	1.19
HIPS;	1.03
PVA;	1.23
ASA;	1.05
PP;	    0.9
POM;	1.4
PMMA;	1.18
FPE;	2.16
                        </textarea>
                    </div>
                </div>
-->

                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.tdFieldEnabled"> {{ _('Show the TD field in the spool dialog') }}
                        </label>
                        <span class="help-block">
                            <small>
                                {{ _('TD (transmission distance) is how far light travels through the filament before it turns opaque - used by HueForge and OrcaSlicer to plan color layers. Measuring it needs a printed test swatch, so the field stays hidden unless you work with it.') }}<br>
                                {{ _('The value is still read from vendor RFID tags and stored either way; this only controls whether the field is shown for manual editing.') }}
                            </small>
                        </span>
                    </div>
                </div>

                <!-- Settings migration from a previous "SpoolManager" install -->
                <div class="control-group" data-bind="visible: legacyMigrationAvailable">
                    <h4>{{ _('Migrate settings') }}</h4>
                    <div class="controls">
                        <button class="btn"
                                data-bind="enable: legacySettingsAvailable() && !legacyMigrationInProgress(),
                                           click: showLegacySettingsDialog">
                            <i class="fas fa-sliders-h"></i> {{ _('Migrate settings') }}
                        </button>
                        <span class="help-inline" data-bind="visible: !legacySettingsAvailable()">
                            {{ _('The previous installation has no settings of its own.') }}
                        </span>
                        <span class="help-block">
                            <small>
                                {{ _('Takes over the plugin settings of a previous SpoolManager installation - units and currency, temperature offsets, QR code, database connection, and the other options on these tabs. Opens a comparison first, where you pick field by field what to adopt.') }}<br>
                                {{ _('Spools are not affected: the database is migrated separately under Storage.') }}
                            </small>
                        </span>
                    </div>
                </div>
                <div class="control-group" data-bind="visible: legacySettingsUndoAvailable">
                    <div class="controls">
                        <button class="btn"
                                data-bind="disable: legacyMigrationInProgress, click: undoLegacySettingsAction">
                            <i class="fas fa-undo"></i> {{ _('Undo settings migration') }}
                        </button>
                        <span class="help-inline">{{ _('Restores the settings it overwrote.') }}</span>
                    </div>
                </div>

            </div>

            <!-- TEMPERATURE - TAB -->
            <div class="tab-pane" id="spmx-tab-spool-Temperature">
                <div class="control-group">
                    <h4>Temperature Offsets</h4>
                    <div>
                        Setting these will replace the current offset value on the temperature tab with the value set in the temperature field of the selected spool.
                    </div>
                    <br>

                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.toolOffsetEnabled" > Update Tool Offset with the spool Tool Temperature value
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.bedOffsetEnabled" > Update Bed Offset with the spool Bed Temperature value
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.enclosureOffsetEnabled" > Update Enclosure Offset with the spool Enclosure Temperature value
                        </label>
                        <span class="help-inline">HINT: You will need to reselect a spool or reconnect the printer for changes from this page to take effect.</span>
                    </div>
                </div>

                <div class="control-group">
                    <div class="alert alert-info" style="margin-bottom: 0px !important">
                        <div style="font-weight: bold">Note for Bambu Connector users</div>
                        <div>Temperature offsets are <b>not</b> transferred to the printer when using the Bambu connector. Prints run from printer storage and use the temperatures from the sliced file only.</div>
                    </div>
                </div>
            </div>

            <!-- QR - Code - TAB -->
            <div class="tab-pane" id="spmx-tab-spool-QR-Code">
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.qrCodeEnabled" > Show generated QR-Code in Spool-Dialog.
                        </label>
                    </div>
                </div>
                <hr/>
                <div class="control-group">
                    <label class="control-label">Fill color</label>
                    <div class="controls">
                        {# Container for the color picker component; the value is kept in sync
                           with pluginSettings.qrCodeFillColor in SpoolManager.js. #}
                        <span id="spmx-qrcode-fill-color-picker"></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">Background color</label>
                    <div class="controls">
                        <span id="spmx-qrcode-background-color-picker"></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">
                        <button data-bind="click: reloadQRCodePreviewImage">Reload Image</button>
                    </label>
                    <div class="controls">
                        <a data-bind="attr: $root.generateQRCodeImageSourceAttribute('qrPreviewId','qrPreviewLabel', 'htmlView')" target="_new">
                            <img id="spmx-settings-qrimage-preview" loading="lazy" class="qr-code-large" alt="QR Code" data-bind="attr: $root.generateQRCodeImageSourceAttribute('qrPreviewId',
                                                                                                                                              'qrPreviewLabel',
                                                                                                                                              '',
                                                                                                                                              true)">
                        </a>
                    </div>
                </div>
                <hr/>
                <div class="control-group">
                    <label class="control-label">Label size (print)</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" min="1" class="input-mini text-right" data-bind="value: pluginSettings.qrCodeLabelWidthMM">
                            <span class="add-on">mm</span>
                        </div>
                        &times;
                        <div class="input-append">
                            <input type="number" step="1" min="1" class="input-mini text-right" data-bind="value: pluginSettings.qrCodeLabelHeightMM">
                            <span class="add-on">mm</span>
                        </div>
                        <span class="help-block">Page size (width &times; height) used when printing the label via "Preview Label". Default 89 &times; 36 mm (Dymo 99012 address label).</span>
                    </div>
                </div>
                <hr/>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.qrCodeUseURLPrefix"> Use URL prefix for QR-Code URL
                        </label>
                    </div>
                    <div class="controls">
                        <input type="text" class="input-xlarge text-left" data-bind="value: pluginSettings.qrCodeURLPrefix, enable: pluginSettings.qrCodeUseURLPrefix" placeholder="http://192.0.2.0">
                    </div>
                    <div class="control-label" data-bind="visible:pluginSettings.qrCodeUseURLPrefix" >
                        <a class="text-center" target="_newTab" data-bind="attr: $root.generateQRCodeTestLink()">
                            <span data-bind="text: pluginSettings.qrCodeURLPrefix"></span>/plugin/SpoolManager/selectSpoolByQRCode/'databaseId'
                        </a>
                    </div>

                </div>
            </div>

            <!-- Template - TAB -->
            <div class="tab-pane" id="spmx-tab-spool-Template">
                <div>
                    Which fields should be copied when creating a new spool from a template?
                </div>
                <br/>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('displayName')" > Display Name<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('material')" > Material<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('vendor')" > Vendor<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('density')" > Density<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('diameter')" > Diameter<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('diameterTolerance')" > Diameter Tolerance<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('flowRateCompensation')" > Flow Rate Compensation<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('temperature')" > Temperature<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('bedTemperature')" > Bed Temperature<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('enclosureTemperature')" > Enclosure Temperature<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('offsetTemperature')" > Offset Temperature<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('offsetEnclosureTemperature')" > Offset Enclosure<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('totalWeight')" > Total Weight<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('totalLength')" > Total Length<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('code')" > Serialnumber<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('batchNumber')" > Batchnumber<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('purchasedFrom')" > Purchased from<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('cost')" > Cost<br/>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: checkExcludedFromTemplateCopy('allNotes')" > Notes<br/>
                        </label>
                    </div>
                </div>

            </div>

            <!-- EXPORT / IMPORT - TAB -->
            <div class="tab-pane" id="spmx-tab-spool-Export-Import">

                <div class="control-group">
                    <div class="alert alert-info" style="margin-bottom: 0px !important">
                        <div style="font-weight: bold">Database in Use: <span data-bind="text: databaseInUse"></span></div>
                        <div>Importing and exporting of SpoolManager data will be done against this database instance.</div>
                    </div>
                </div>

                <h3>Export</h3>
                <div class="control-group">
                    <div class="controls">
                        <span><b>SpoolManager Database</b>: Export all data as
                            <a target="_newTab" href="#" data-bind="visible: pluginSettings.useExternal, attr: {href: $root.apiClient.getExportUrl('CSV', 'external')}">CSV-File</a>
                            <a target="_newTab" href="#" data-bind="hidden: pluginSettings.useExternal, attr: {href: $root.apiClient.getExportUrl('CSV', 'internal')}">CSV-File</a>
                        </span>
                    </div>
                </div>
                <!-- Internal SQLite: full .db file export -->
                <div class="control-group" data-bind="hidden: pluginSettings.useExternal">
                    <div class="controls">
                        <span><b>Local SQLite Database</b>: Export the full database as
                            <a class="btn btn-info btn-mini" href="#" data-bind="attr: {href: downloadDatabaseUrl}" target="_blank"><i class="icon-download"></i> Database file (.db)</a>
                        </span>
                    </div>
                </div>
                <!-- External MySQL: full .sql dump export (moved here from the Storage tab) -->
                <div class="control-group" data-bind="visible: isExternalMySQL">
                    <div class="controls">
                        <span><b>External MySQL Database</b>: Export the full database as
                            <a class="btn btn-info btn-mini" href="#" data-bind="attr: {href: getDatabaseDumpExportUrl()}"><i class="icon-download"></i> SQL-Dump (.sql)</a>
                        </span>
                        <div class="help-block" style="margin-top: 5px;">
                            The .sql dump works on the <b>saved</b> connection settings (MySQL only). Save the storage settings first.
                        </div>
                    </div>
                </div>
                <div class="control-group" data-bind="visible: isFilamentManagerPluginAvailable">
                    <div class="controls">
                        <span><b>Legacy: Filament Manager Database</b>: Export all data as <a target="_newTab" href="#" data-bind="attr: {href: $root.apiClient.getExportUrl('legacyFilamentManager', 'internal'), css: {disabled: !$root.apiClient.getExportUrl('legacyFilamentManager', 'internal')}}">CSV-File</a></span>
                    </div>
                </div>


                <h3>Import</h3>

                <div class="alert alert-info" style="margin-bottom: 10px;">
                    A safety backup of the current database is automatically created and downloaded
                    <b>before</b> every import (append and replace). If the backup fails, the import is aborted.
                </div>
                <div class="alert" data-bind="visible: printerStateViewModel.isBusy()" style="">
                        Take note that import functionality is disabled while your printer is printing or paused.
                </div>

                <h4>CSV Import</h4>
                <div class="control-group" data-bind="visible: !printerStateViewModel.isBusy()">
                    <div class="controls">
                        <div class="row">
                            Import a CSV-File to the SpoolManager database.
                        </div>
                        <br/>
                        <div class="row">
                            <div class="span6">
                                <label class="radio">
                                    <input type="radio" name="importCSVMode" value="replace" data-bind="checked: pluginSettings.importCSVMode"> Replace <span data-bind="text: databaseInUse().toLowerCase()"></span> database
                                </label>
                                <label class="radio">
                                        <input type="radio" name="importCSVMode" value="append" data-bind="checked: pluginSettings.importCSVMode"> Append to <span data-bind="text: databaseInUse().toLowerCase()"></span> database
                                </label>
                            </div>

                            <div class="span6">
                                <div class="input-prepend">
                                    <span class="btn fileinput-button">
                                        <span>Browse...</span>
                                        <input id="spmx-settings-spool-importcsv-upload"
                                               type="file"
                                               name="file"
{#                                               data-url="/plugin/SpoolManager/importCSV"#}
                                               data-url="{{ url_for("plugin.SpoolManagerExtended.importSpoolData") }}"
                                               accept=".csv">
                                    </span>
                                    <span class="add-on" data-bind="text: csvFileUploadName"></span>
                                </div>
                                <button class="btn btn-primary"
                                        data-bind="disable: (csvImportInProgress() || csvFileUploadName() == undefined), click: performCSVImportFromUpload">
                                    <i class="fa fa-spinner fa-spin"
                                       data-bind="visible: csvImportInProgress"></i> Upload & import
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Internal SQLite: .db file restore (replace = whole-file swap, append = insert spools) -->
                <div data-bind="hidden: pluginSettings.useExternal">
                    <h4>Database File Restore (.db)</h4>
                    <div class="control-group" data-bind="visible: !printerStateViewModel.isBusy()">
                        <div class="controls">
                            <div class="row">
                                Restore the local SQLite database from a <b>.db</b> file. Replace swaps the whole database file; append inserts the spools from the file.
                            </div>
                            <br/>
                            <div class="row">
                                <div class="span6">
                                    <label class="radio">
                                        <input type="radio" name="dbRestoreMode" value="replace" data-bind="checked: dbRestoreMode"> Replace local database
                                    </label>
                                    <label class="radio">
                                        <input type="radio" name="dbRestoreMode" value="append" data-bind="checked: dbRestoreMode"> Append spools to local database
                                    </label>
                                </div>
                                <div class="span6">
                                    <div class="input-prepend">
                                        <span class="btn fileinput-button">
                                            <span>Browse...</span>
                                            <input id="settings-spool-importdb-upload"
                                                   type="file"
                                                   name="file"
                                                   accept=".db"
                                                   data-bind="event: {change: dbRestoreFileChanged}">
                                        </span>
                                        <span class="add-on" data-bind="text: dbRestoreFileName"></span>
                                    </div>
                                    <button class="btn btn-primary"
                                            data-bind="disable: (dbRestoreInProgress() || dbRestoreFileName() == undefined), click: performDBRestoreFromUpload">
                                        <i class="fa fa-spinner fa-spin"
                                           data-bind="visible: dbRestoreInProgress"></i> Upload & restore
                                    </button>
                                    <div class="help-block" data-bind="visible: dbRestoreResultText">
                                        <div class="alert alert-success">
                                            <font color="green"><b><span data-bind="text: dbRestoreResultText"></span></b></font>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- External MySQL: .sql dump import (moved here from the Storage tab) -->
                <div data-bind="visible: isExternalMySQL">
                    <h4>SQL-Dump Import</h4>
                    <div class="control-group" data-bind="visible: !printerStateViewModel.isBusy()">
                        <div class="controls">
                            <div class="row">
                                Import a full <b>.sql</b> dump into the external MySQL database. Works on the <b>saved</b> connection settings.
                            </div>
                            <br/>
                            <div class="row">
                                <div class="span6">
                                    <label class="radio">
                                        <input type="radio" name="sqlImportMode" value="replace" data-bind="checked: sqlImportMode"> Replace external database
                                    </label>
                                    <label class="radio">
                                        <input type="radio" name="sqlImportMode" value="append" data-bind="checked: sqlImportMode"> Append spools to external database
                                    </label>
                                </div>
                                <div class="span6">
                                    <div class="input-prepend">
                                        <span class="btn fileinput-button">
                                            <span>Browse...</span>
                                            <input id="settings-spool-importsql-upload"
                                                   type="file"
                                                   name="file"
                                                   accept=".sql"
                                                   data-bind="event: {change: sqlDumpFileChanged}">
                                        </span>
                                        <span class="add-on" data-bind="text: sqlDumpFileName"></span>
                                    </div>
                                    <button class="btn btn-primary"
                                            data-bind="disable: (sqlImportInProgress() || sqlDumpFileName() == undefined), click: performSQLImportFromUpload">
                                        <i class="fa fa-spinner fa-spin"
                                           data-bind="visible: sqlImportInProgress"></i> Upload & import
                                    </button>
                                    <div class="help-block" data-bind="visible: sqlImportResultText">
                                        <div class="alert alert-success">
                                            <font color="green"><b><span data-bind="text: sqlImportResultText"></span></b></font>
