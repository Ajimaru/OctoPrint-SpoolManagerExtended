                                    <small class="muted">{{ _('NDEF/JSON, NTAG & NFC-V, phone-readable') }}</small>
                                    <ul style="padding-left: 16px; margin: 6px 0 0; font-size: 12px;">
                                        <li>{{ _('Database ID') }}</li>
                                        <li>{{ _('Material') }}</li>
                                        <li>{{ _('Vendor') }}</li>
                                        <li>{{ _('Color (hex)') }}</li>
                                        <li>{{ _('Diameter') }}</li>
                                        <li>{{ _('Nozzle / bed temp (min/max)') }}</li>
                                        <li class="muted">{{ _('Color name - not written') }}</li>
                                        <li class="muted">{{ _('Density - not written') }}</li>
                                        <li class="muted">{{ _('Spool / used weight - not written') }}</li>
                                        <li class="muted">{{ _('Nozzle / bed target temp - not written') }}</li>
                                        <li class="muted">{{ _('Enclosure temp - not written') }}</li>
                                        <li class="muted">{{ _('Drying temp / time - not written') }}</li>
                                        <li class="muted">{{ _('TD - not written') }}</li>
                                    </ul>
                                    <small class="help-block" style="margin-top: 4px; border-left: 2px solid #ddd; padding-left: 8px;">
                                        {{ _('These have no equivalent in the OpenSpool specification - true for every tag size.') }}
                                    </small>
                                </div>
                                <div class="span4">
                                    <strong style="font-size: 12px;">{{ _('OpenPrintTag') }}</strong><br>
                                    <small class="muted">{{ _('CBOR/NDEF, NFC-V only, vendor-neutral spec') }}</small>
                                    <ul style="padding-left: 16px; margin: 6px 0 0; font-size: 12px;">
                                        <li>{{ _('Material (name + class + type)') }}</li>
                                        <li>{{ _('Vendor') }}</li>
                                        <li>{{ _('Color (RGB)') }}</li>
                                        <li>{{ _('Diameter') }}</li>
                                        <li>{{ _('Density') }}</li>
                                        <li>{{ _('Full / empty weight') }}</li>
                                        <li>{{ _('Print temp (min/max + preheat)') }}</li>
                                        <li>{{ _('Bed temp (min/max)') }}</li>
                                        <li>{{ _('Drying temp / time') }}</li>
                                        <li>{{ _('TD (transmission distance)') }}</li>
                                        <li class="muted">{{ _('Database ID - not written') }}</li>
                                        <li class="muted">{{ _('Color name - not written') }}</li>
                                        <li class="muted">{{ _('Used weight - not written') }}</li>
                                        <li class="muted">{{ _('Batch number, serial, purchase date - not written') }}</li>
                                    </ul>
                                    <small class="help-block" style="margin-top: 4px; border-left: 2px solid #ddd; padding-left: 8px;">
                                        {{ _('The spec has no database id field - a scanned tag is matched by its own UID instead.') }}
                                    </small>
                                </div>
                            </div>
                            <div class="row-fluid" style="margin-top: 10px;">
                                <div class="span4">
                                    <strong style="font-size: 12px;">{{ _('TigerTag') }}</strong><br>
                                    <small class="muted">{{ _('Raw page layout, NTAG213/215/216, open spec (unsigned/Standard only)') }}</small>
                                    <ul style="padding-left: 16px; margin: 6px 0 0; font-size: 12px;">
                                        <li>{{ _('Material, brand, aspect, diameter, weight unit (TigerTag\'s own numeric ids)') }}</li>
                                        <li>{{ _('Color (RGB)') }}</li>
                                        <li>{{ _('Total weight') }}</li>
                                        <li>{{ _('Nozzle temp (min/max)') }}</li>
                                        <li>{{ _('Bed temp (min/max)') }}</li>
                                        <li>{{ _('Drying temp / time') }}</li>
                                        <li class="muted">{{ _('Database ID - not written') }}</li>
                                        <li class="muted">{{ _('Color name, density, used weight - not written') }}</li>
                                        <li class="muted">{{ _('Serial, batch number, purchase info, finish, display name, dates, TD - not written') }}</li>
