                        </span>
                    </div>
                </div>

                <div class="control-group" data-bind="visible: u1RfidTestMessage">
                    <div class="controls">
                        <div class="alert" data-bind="text: u1RfidTestMessage, css: {'alert-success': u1RfidTestOk(), 'alert-error': !u1RfidTestOk()}"></div>
