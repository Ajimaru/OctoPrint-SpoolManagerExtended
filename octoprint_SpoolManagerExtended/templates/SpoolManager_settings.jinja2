                        <table class="table table-condensed" style="margin-bottom: 6px;">
                            <tbody>
                                <tr>
                                    <td style="width: 24px;">
                                        <i data-bind="css: u1RfidStatus().chain && u1RfidStatus().chain.connector ? 'icon-ok text-success' : 'icon-remove text-error'"></i>
                                    </td>
                                    <td>MoonrakerConnector plugin available</td>
                                </tr>
                                <tr>
                                    <td>
                                        <i data-bind="css: u1RfidStatus().chain && u1RfidStatus().chain.moonraker ? 'icon-ok text-success' : 'icon-remove text-error'"></i>
                                    </td>
                                    <td>
                                        Active printer is a Moonraker printer
                                        <span data-bind="visible: u1RfidStatus().host">
                                            &mdash; <code data-bind="text: u1RfidStatus().host + ':' + u1RfidStatus().port"></code>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <i data-bind="css: u1RfidStatus().chain && u1RfidStatus().chain.printer ? 'icon-ok text-success' : 'icon-minus muted'"></i>
                                    </td>
                                    <td>
                                        Printer identified
                                        <span data-bind="visible: u1RfidStatus().printerInfo && u1RfidStatus().printerInfo.machineType">
                                            &mdash; <span data-bind="text: u1RfidStatus().printerInfo.machineType"></span>
                                            (<span data-bind="text: u1RfidStatus().printerInfo.deviceName"></span>,
                                            firmware <span data-bind="text: u1RfidStatus().printerInfo.firmwareVersion"></span>)
                                        </span>
                                        <br><small class="muted">Informational only - the model does not gate the feature.</small>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <i data-bind="css: u1RfidStatus().chain && u1RfidStatus().chain.filamentDetect ? 'icon-ok text-success' : 'icon-remove text-error'"></i>
                                    </td>
                                    <td>
                                        RFID support (<code>filament_detect</code>) present
                                        <br><small class="muted">This is what unlocks the feature. Requires the Extended Firmware.</small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="alert" data-bind="visible: u1RfidStatus().chainMessage, text: u1RfidStatus().chainMessage"></div>
                    </div>
                </div>

                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.u1RfidEnabled, enable: u1RfidStatus().supported"> Read RFID tags from the Snapmaker U1
                        </label>
                        <span class="help-block">
                            <small data-bind="visible: !u1RfidStatus().supported">
                                Disabled because the detection above did not complete. The printer host is derived
                                automatically from the Moonraker connection - there is nothing to enter by hand.
                            </small>
                            <small data-bind="visible: u1RfidStatus().supported">
                                Inserting a spool makes the U1 read its tag; a tag known to SpoolManager (matched by
                                its UID in the spool's <em>Code</em> field) is loaded into the matching tool.
                            </small>
                        </span>
                    </div>
                </div>

                <div class="control-group">
                    <div class="controls">
                        <button class="btn" data-bind="click: testU1RfidConnection, enable: !u1RfidTesting()">
                            <i class="icon-refresh" data-bind="css: {'icon-spin': u1RfidTesting}"></i> Test connection
