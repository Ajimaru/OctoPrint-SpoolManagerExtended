                            <option value="openSpool">{{ _('OpenSpool (NDEF/JSON, phone-readable, fewer fields)') }}</option>
                            <option value="openPrintTag">{{ _('OpenPrintTag (open standard, cross-vendor, needs a large tag)') }}</option>
                        </select>
                        <span class="help-block">
                            <small>
                                <strong>{{ _('Extended') }}</strong> {{ _('writes every field OctoScale knows, including 1-3 colors plus transparent/rainbow.') }}<br>
                                <strong>{{ _('OpenSpool') }}</strong> {{ _('writes a standard NDEF/JSON record any phone NFC app can read, with fewer fields (no color name, density, spool/used weight) and a single opaque color.') }}<br>
                                <strong>{{ _('OpenPrintTag') }}</strong> {{ _('writes a vendor-neutral CBOR/NDEF record other OpenPrintTag tools can read. A spool that does not fit fails the write outright instead of dropping fields. A single opaque color.') }}
                            </small>
                        </span>
                    </div>
                </div>
