include README.md
recursive-include octoprint_SpoolManagerExtended/templates *
recursive-include octoprint_SpoolManagerExtended/translations *
recursive-include octoprint_SpoolManagerExtended/static *
# Vendored 3rd-party licences. BSD-3-Clause (Quill) requires the copyright notice,
# conditions and disclaimer to accompany redistributions in binary form - the minified
# bundles under static/ only carry the copyright header, so the full text ships here.
include 3rdPartySoftware/*/LICENSE
# Static lookup tables for vendor tag parsers (TigerTag ids).
recursive-include octoprint_SpoolManagerExtended/common/tagdata *.json
