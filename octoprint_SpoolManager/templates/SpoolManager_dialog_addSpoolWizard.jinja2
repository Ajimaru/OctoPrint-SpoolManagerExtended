<div id="dialog_addSpoolWizard" class="modal hide fade" data-bind="with: addSpoolWizard">
    <div class="modal-header">
        <!-- no data-dismiss: cancelDialog resets the wizard state, a plain dismiss would leave
             the collected step data behind. Hidden in the NFC step, same as the Cancel button. -->
        <a href="#" class="close" aria-hidden="true"
           data-bind="click: cancelDialog, visible: currentStepId() !== 'nfc'">&times;</a>
        <h3 class="modal-title">
            {{ _('Add Spool Wizard') }}
            <small data-bind="text: currentStepTitle"></small>
        </h3>
        <div class="spm-wizard-progress">
            <div class="progress progress-striped" style="margin-bottom: 4px;">
                <div class="bar" data-bind="style: { width: progressPercentage() + '%' }"></div>
            </div>
            <small class="muted" data-bind="text: stepCounterText"></small>
        </div>
    </div>

    <div class="modal-body spm-wizard-body">
        <form class="form-horizontal" id="spool-wizard-form">

            <!-- STEP: READ VENDOR TAG -->
            <!-- First step on purpose: what is read here prefills every step that follows.
                 Entirely skippable - "Skip" is the plain Next button below. -->
            <div data-bind="visible: currentStepId() === 'readTag'">
                <p>{{ _('Does this spool have a manufacturer RFID tag? Place it on the OctoScale reader and read it - the values below then prefill the rest of the wizard.') }}</p>

                <div data-bind="visible: !octoScaleTagWriter.tagPresent()">
                    <i class="fas fa-spinner fa-spin"></i>
                    <small>{{ _('Waiting for a tag on the reader...') }}</small>
                </div>

                <div data-bind="visible: octoScaleTagWriter.tagPresent">
                    <i class="fas fa-check text-success"></i>
                    <small>{{ _('Tag detected') }}<span data-bind="visible: octoScaleTagWriter.chipLabel">
                        (<span data-bind="text: octoScaleTagWriter.chipLabel"></span>)</span></small>
                </div>

                <div style="margin-top: 10px;" data-bind="visible: octoScaleTagWriter.tagPresent() && octoScaleTagWriter.readTagResult() == null">
                    <button type="button" class="btn btn-primary"
                            data-bind="click: octoScaleTagWriter.readTag, enable: octoScaleTagWriter.canReadTag">
                        <i class="fas fa-spinner fa-spin" data-bind="visible: octoScaleTagWriter.isReadingTag"></i>
                        {{ _('Read tag') }}
                    </button>
                    <span style="margin-left: 8px;" data-bind="visible: octoScaleTagWriter.isReadingTag">
                        <small>{{ _('Reading - please leave the tag on the reader...') }}</small>
                    </span>
                </div>

                <div class="text-warning" style="margin-top: 10px;" data-bind="visible: octoScaleTagWriter.readTagError">
                    <i class="fas fa-info-circle"></i>
                    <span data-bind="text: octoScaleTagWriter.readTagError"></span>
                </div>

                <!-- ko if: octoScaleTagWriter.readTagResult() != null && octoScaleTagWriter.readTagResult().parsed === true -->
                <div class="alert alert-info" style="margin-top: 12px;">
                    <i class="fas fa-check"></i>
                    {{ _('Recognized as') }} <strong data-bind="text: octoScaleTagWriter.readTagResult().parserLabel"></strong>.
                    <!-- ko if: octoScaleTagWriter.readTagResult().matchedSpoolId != null -->
                    <div class="text-warning" style="margin-top: 6px;">
                        <i class="fas fa-exclamation-triangle"></i>
                        {{ _('This tag already belongs to') }}
                        <strong data-bind="text: octoScaleTagWriter.readTagResult().matchedSpoolDisplayName"></strong>
                        ({{ _('id') }} <span data-bind="text: octoScaleTagWriter.readTagResult().matchedSpoolId"></span>).
                        {{ _('Creating a new spool from it would give you a duplicate.') }}
                    </div>
                    <!-- /ko -->
                    <table class="table table-condensed" style="margin: 8px 0 0 0;">
                        <tbody data-bind="foreach: octoScaleTagWriter.readTagValues">
                            <tr>
                                <td style="padding: 2px 8px 2px 0; border: none;"><small data-bind="text: label"></small></td>
                                <td style="padding: 2px 0; border: none;"><small data-bind="text: valueText"></small></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-primary" style="margin-top: 6px;"
                            data-bind="click: applyReadTagValues">{{ _('Use these values') }}</button>
                    <button type="button" class="btn" style="margin-left: 8px; margin-top: 6px;"
                            data-bind="click: octoScaleTagWriter.clearReadTagResult">{{ _('Discard') }}</button>
                </div>
                <!-- /ko -->

                <p class="help-block" style="margin-top: 14px;">
                    <small>{{ _('No tag, or you would rather enter everything by hand? Just continue with Next.') }}</small>
                </p>
            </div>

            <!-- STEP: MODE -->
            <div data-bind="visible: currentStepId() === 'mode'">
                <p>{{ _('How much do you want to fill in for this spool?') }}</p>
                <label class="radio">
                    <input type="radio" name="wizardFieldSet" value="false" data-bind="checked: useFullFieldSet, checkedValue: false">
                    <strong>{{ _('Essentials only') }}</strong>
                    <span class="help-block"><small>{{ _('Name, color, material, filament properties and weight. Everything you need to track filament usage.') }}</small></span>
                </label>
                <label class="radio">
                    <input type="radio" name="wizardFieldSet" value="true" data-bind="checked: useFullFieldSet, checkedValue: true">
                    <strong>{{ _('All details') }}</strong>
                    <span class="help-block"><small>{{ _('Adds temperatures, purchase information, cost and further details.') }}</small></span>
                </label>

                <div class="control-group" style="margin-top: 18px;" data-bind="visible: hasTemplateSpools">
                    <label class="control-label">{{ _('Start from template') }}</label>
                    <div class="controls">
                        <select class="input-large" data-bind="options: templateSpools,
                                                               optionsText: function(item){ return item.displayName(); },
                                                               optionsCaption: '{{ _('Start with an empty spool') }}',
                                                               value: selectedTemplateSpool,
                                                               event: { change: function(){ applyTemplateSpool(selectedTemplateSpool()); return true; } }">
                        </select>
                        <span class="help-block"><small>{{ _('Prefills the fields from a template spool. You can still change every value in the following steps.') }}</small></span>
                    </div>
                </div>
            </div>

            <!-- STEP: IDENTITY -->
            <div data-bind="visible: currentStepId() === 'identity'">
                <div class="control-group" data-bind="css: {error: !isDisplayNamePresent()}">
                    <label class="control-label">{{ _('Display name') }} *</label>
                    <div class="controls">
                        <input type="text" class="input-xlarge" autocomplete="off"
                               data-bind="textInput: spoolItemForCreation.displayName">
                        <span class="help-block" data-bind="visible: nextSpoolId() != null">
                            <small>{{ _('This spool will get the database id') }} <strong data-bind="text: nextSpoolId"></strong>.</small>
                        </span>
                    </div>
                </div>
                <div class="control-group" data-bind="css: {error: !isVendorPresent()}">
                    <label class="control-label">{{ _('Vendor') }} *</label>
                    <div class="controls">
                        <div class="input-append dropdown">
                            <input id="wizard-spool-vendor" type="text" class="input-large"
                                list="wizard-spool-vendor-list"
                                   autocomplete="off" placeholder="{{ _('Choose or type...') }}"
                                   data-bind="textInput: spoolItemForCreation.vendor">
                            <datalist id="wizard-spool-vendor-list" data-bind="foreach: allVendors">
                                <option data-bind="attr: { value: $data }"></option>
                            </datalist>
                            <button class="btn dropdown-toggle" type="button" data-toggle="dropdown"
                                    title="{{ _('Choose vendor') }}" aria-label="{{ _('Choose vendor') }}">
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu spm-vendor-menu">
                                <!-- ko if: userVendors().length -->
                                <li class="nav-header">{{ _('Your vendors') }}</li>
                                <!-- ko foreach: userVendors -->
                                <li><a href="#" data-bind="text: $data, click: $root.addSpoolWizard.selectVendor"></a></li>
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- ko if: spoolmanDbVendors().length -->
                                <li class="divider"></li>
                                <li class="nav-header">{{ _('SpoolmanDB vendors') }}</li>
                                <!-- ko foreach: spoolmanDbVendors -->
                                <li><a href="#" data-bind="text: $data, click: $root.addSpoolWizard.selectVendor"></a></li>
                                <!-- /ko -->
                                <!-- /ko -->
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="control-group" data-bind="css: {error: !isMaterialPresent()}">
                    <label class="control-label">{{ _('Material') }} *</label>
                    <div class="controls">
                        <input id="wizard-spool-material" type="text" class="input-large" list="wizard-spool-material-list"
                               autocomplete="off" placeholder="{{ _('Choose or type...') }}"
                               data-bind="textInput: spoolItemForCreation.material">
                        <datalist id="wizard-spool-material-list" data-bind="foreach: allMaterials">
                            <option data-bind="attr: { value: $data }"></option>
                        </datalist>
                        <span class="help-block"><small>{{ _('Choosing a known material fills in a matching density.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Variant') }}</label>
                    <div class="controls">
                        <input type="text" class="input-large" autocomplete="off"
                               placeholder="{{ _('Silk, Matte, ...') }}"
                               data-bind="textInput: spoolItemForCreation.materialCharacteristic">
                        <span class="help-block"><small>{{ _('Filled in from a vendor tag when it carries one. Kept separate from Material so the density lookup keeps working.') }}</small></span>
                    </div>
                </div>
                <div class="control-group" data-bind="visible: spoolmanProducts().length || spoolmanLoading()">
                    <label class="control-label">{{ _('SpoolmanDB product') }}</label>
                    <div class="controls">
                        <select class="input-large" data-bind="options: spoolmanProducts,
                                                              optionsText: 'name',
                                                              value: selectedSpoolmanProduct,
                                                              optionsCaption: spoolmanLoading() ? '{{ _('Loading...') }}' : '{{ _('Choose...') }}',
                                                              enable: !spoolmanLoading() && !isU1RfidFlow()"></select>
                        <span class="help-block" data-bind="visible: isU1RfidFlow"><small>{{ _('Disabled - this spool is prefilled from its RFID tag, which knows the exact values for this physical spool. Picking a catalog product here would overwrite them with generic ones.') }}</small></span>
                        <span class="help-block" data-bind="visible: !isU1RfidFlow() && selectedSpoolmanProduct() && selectedSpoolmanProduct().ambiguous"><small>{{ _('Multiple temperature variants exist; no temperature is prefilled.') }}</small></span>
                        <span class="help-block" data-bind="visible: !isU1RfidFlow() && selectedSpoolmanProduct() && (selectedSpoolmanProduct().extruder_temp_range || selectedSpoolmanProduct().bed_temp_range)"><small>{{ _('A range is prefilled into the min/max temperature fields below.') }}</small></span>
                    </div>
                </div>
            </div>

            <!-- STEP: COLOR -->
            <div data-bind="visible: currentStepId() === 'color'">
                {# Up to three colors, same as the edit dialog - and since the color picker
                   component takes a container element rather than a fixed id, both dialogs
                   can now use the very same widget (see common/colorPicker.js). #}
                <div class="control-group">
                    <label class="control-label">{{ _('Color') }}</label>
                    <div class="controls">
                        <span data-bind="visible: !isRainbow() && !isColorless()">
                            <span id="wizard-color-picker"></span>
                            <span data-bind="visible: colorCount() >= 2"><span id="wizard-color-picker2"></span></span>
                            <span data-bind="visible: colorCount() >= 3"><span id="wizard-color-picker3"></span></span>
                            <a href="#" class="btn btn-mini" title="{{ _('Add a color (multi-color spool)') }}"
                               data-bind="click: addColor, visible: colorCount() < 3"><i class="fas fa-plus"></i></a>
                            <a href="#" class="btn btn-mini" title="{{ _('Remove last color') }}"
                               data-bind="click: removeColor, visible: colorCount() > 1"><i class="fas fa-minus"></i></a>
                        </span>
                        <span class="color-preview" style="margin-left: 8px; margin-bottom: -5px;"
                              data-bind="style: {'background': spmSpoolColorCss(spoolItemForCreation.color)}"></span>
                    </div>
                </div>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: isRainbow"> {{ _('Rainbow (preset gradient)') }}
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: isTransparent"> {{ _('Transparent / translucent') }}
                        </label>
                        <label class="checkbox" style="margin-left: 20px;" data-bind="visible: isTransparent">
                            <input type="checkbox" data-bind="checked: isColorless"> {{ _('completely colorless (no base color)') }}
                        </label>
                    </div>
                </div>
                <div class="control-group" data-bind="css: {error: !isColorNamePresent()}">
                    <label class="control-label">{{ _('Color name') }} *</label>
                    <div class="controls">
                        <input type="text" class="input-large" list="wizard-color-list"
                               data-bind="textInput: spoolItemForCreation.colorName">
                        <datalist id="wizard-color-list" data-bind="foreach: allColors">
                            <option data-bind="attr: { value: $data }"></option>
                        </datalist>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Finish') }}</label>
                    <div class="controls">
                        <select class="input-medium" data-bind="options: finishOptions,
                                                                optionsText: 'text', optionsValue: 'value',
                                                                optionsCaption: '',
                                                                value: spoolItemForCreation.finishSelection">
                        </select>
                        <input type="text" class="input-medium" placeholder="{{ _('Custom finish') }}"
                               data-bind="visible: spoolItemForCreation.finishSelection() === 'custom',
                                          textInput: spoolItemForCreation.finishCustomText">
                    </div>
                </div>
            </div>

            <!-- STEP: FILAMENT -->
            <div data-bind="visible: currentStepId() === 'filament'">
                <div class="control-group">
                    <label class="control-label">{{ _('Density') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="0.001" min="0" class="input-small text-right"
                                   data-bind="value: spoolItemForCreation.density">
                            <span class="add-on">g/cm³</span>
                        </div>
                        <span class="help-block"><small>{{ _('Needed together with the diameter to predict filament usage.') }}</small></span>
                    </div>
                </div>
                <div class="control-group" data-bind="css: {error: !isDiameterPresent()}">
                    <label class="control-label">{{ _('Diameter') }} *</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="0.001" min="0" class="input-mini text-right"
                                   data-bind="value: spoolItemForCreation.diameter">
                            <span class="add-on">mm</span>
                        </div>
                        <div class="input-prepend input-append">
                            <span class="add-on">±</span>
                            <input type="number" step="0.001" min="0" class="input-mini text-right"
                                   data-bind="value: spoolItemForCreation.diameterTolerance">
                            <span class="add-on">mm</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP: WEIGHT -->
            <div data-bind="visible: currentStepId() === 'weight'">
                <div class="control-group" data-bind="css: {error: !isTotalCombinedWeightPresent()}">
                    <label class="control-label">{{ _('Total weight') }} *</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="any" min="0" class="input-small text-right"
                                   data-bind="value: totalCombinedWeightDisplay,
                                              event: { change: totalCombinedWeightChanged }">
                            <span class="add-on" data-bind="text: weightUnitText">g</span>
                        </div>
                        <span class="help-block"><small>{{ _('The full spool as it comes off the scale: empty spool plus filament.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Empty spool weight') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="any" min="0" class="input-small text-right"
                                   data-bind="value: spoolWeightDisplay,
                                              event: { change: totalCombinedWeightChanged }">
                            <span class="add-on" data-bind="text: weightUnitText">g</span>
                        </div>
                        <span class="help-block">
                            <small data-bind="text: filamentWeightPreview"></small>
                        </span>
                    </div>
                </div>

                <!-- OctoScale weighing -->
                {# no .well here: theme plugins restyle that class and made the panel unreadable #}
                <div style="margin-top: 6px; border-top: 1px solid rgba(128,128,128,0.35); padding-top: 10px;"
                     data-bind="visible: isOctoScaleEnabled">
                    <strong>{{ _('Weigh with OctoScale') }}</strong>
                    <div style="margin-top: 8px;">
                        <button type="button" class="btn btn-small" data-bind="click: toggleWeighing">
                            <i class="fas" data-bind="css: octoScaleWeighing.isActive() ? 'fa-stop' : 'fa-play'"></i>
                            <span data-bind="text: octoScaleWeighing.isActive() ? '{{ _('Stop reading') }}' : '{{ _('Read weight') }}'"></span>
                        </button>
                        <button type="button" class="btn btn-small" data-bind="click: octoScaleWeighing.tare, enable: octoScaleWeighing.isActive() && !octoScaleWeighing.isTaring()">
                            {{ _('Tare') }}
                        </button>
                        <span style="margin-left: 12px; font-size: 18px;" data-bind="text: octoScaleWeighing.currentWeightText"></span>
                        <button type="button" class="btn btn-small btn-primary" style="margin-left: 12px;"
                                data-bind="click: applyMeasuredWeight, enable: octoScaleWeighing.hasReading">
                            {{ _('Use this value') }}
                        </button>
                    </div>
                    <div class="text-error" style="margin-top: 6px;" data-bind="visible: octoScaleWeighing.errorMessage">
                        <i class="fas fa-exclamation-triangle"></i> <span data-bind="text: octoScaleWeighing.errorMessage"></span>
                    </div>
                </div>

                {# RFID flow only: the U1 reads the tag once the filament is LOADED, so the
                   spool is already mounted and threaded. Weighing it would mean retracting,
                   unmounting, weighing and re-threading - hence the opt-out. #}
                <div style="margin-top: 10px; border-top: 1px solid rgba(128,128,128,0.35); padding-top: 10px;"
                     data-bind="visible: isU1RfidFlow">
                    <div data-bind="visible: !weighingSkipped()">
                        <button type="button" class="btn btn-small" data-bind="click: skipWeighing">
                            {{ _('Weigh later') }}
                        </button>
                        <span class="help-block">
                            <small>{{ _('The spool is already loaded in the printer. The weight from the RFID tag (nominal amount) is used for now - you can weigh it any time later.') }}</small>
                        </span>
                    </div>
                    <div class="alert alert-info" style="margin-bottom: 0;" data-bind="visible: weighingSkipped">
                        <i class="fas fa-info-circle"></i>
                        {{ _('Weighing skipped - the spool is saved with the tag\'s nominal weight and marked as estimated.') }}
                    </div>
                </div>

                {# Without the empty spool weight, totalWeight = combined - spoolWeight treats
                   the core as 0 g and every later remaining-weight calculation is off. #}
                <div class="alert alert-warning" style="margin-top: 10px;"
                     data-bind="visible: isU1RfidFlow() && !spoolItemForCreation.spoolWeight()">
                    <i class="fas fa-exclamation-triangle"></i>
                    {{ _('No empty spool weight set. The RFID tag does not carry one and no matching template spool was found - without it the remaining weight cannot be calculated correctly.') }}
                </div>
            </div>

            <!-- STEP: TEMPERATURES (full only) -->
            <div data-bind="visible: currentStepId() === 'temperatures'">
                <div class="control-group">
                    <label class="control-label">{{ _('Tool temperature') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolItemForCreation.temperature">
                            <span class="add-on">°C</span>
                        </div>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Tool temperature range') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" placeholder="min" data-bind="value: spoolItemForCreation.minTemperature">
                            <span class="add-on">°C</span>
                            <input type="number" step="1" class="input-mini text-right" placeholder="max" data-bind="value: spoolItemForCreation.maxTemperature">
                            <span class="add-on">°C</span>
                        </div>
                        <span class="help-block"><small>{{ _('Optional. Leave blank to use the tool temperature above for both.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Bed temperature') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolItemForCreation.bedTemperature">
                            <span class="add-on">°C</span>
                        </div>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Bed temperature range') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" placeholder="min" data-bind="value: spoolItemForCreation.minBedTemperature">
                            <span class="add-on">°C</span>
                            <input type="number" step="1" class="input-mini text-right" placeholder="max" data-bind="value: spoolItemForCreation.maxBedTemperature">
                            <span class="add-on">°C</span>
                        </div>
                        <span class="help-block"><small>{{ _('Optional. Leave blank to use the bed temperature above for both.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Enclosure temperature') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolItemForCreation.enclosureTemperature">
                            <span class="add-on">°C</span>
                        </div>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Drying') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" min="0" class="input-mini text-right" placeholder="temp" data-bind="value: spoolItemForCreation.dryingTemperature">
                            <span class="add-on">°C</span>
                            <input type="number" step="1" min="0" class="input-mini text-right" placeholder="hours" data-bind="value: spoolItemForCreation.dryingTime">
                            <span class="add-on">h</span>
                        </div>
                        <span class="help-block"><small>{{ _('Optional. Most vendor RFID tags carry these values.') }}</small></span>
                    </div>
                </div>
                {# TD is opt-in, same as in the edit dialog: a niche value most users cannot
                   measure, so it stays hidden unless someone actually works with it. #}
                <div class="control-group" data-bind="visible: pluginSettings.tdFieldEnabled()">
                    <label class="control-label">{{ _('TD') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="0.1" min="0.1" max="100" class="input-mini text-right" data-bind="value: spoolItemForCreation.td">
                            <span class="add-on">TD</span>
                        </div>
                        <span class="help-block"><small>{{ _('Optional. Transmission Distance, used by HueForge and OrcaSlicer: 0.1 (most opaque) to 100 (most transparent).') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Flow rate compensation') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolItemForCreation.flowRateCompensation">
                            <span class="add-on">%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP: PURCHASE (full only) -->
            <div data-bind="visible: currentStepId() === 'purchase'">
                <div class="control-group">
                    <label class="control-label">{{ _('Purchased from') }}</label>
                    <div class="controls">
                        <input type="text" class="input-large" data-bind="textInput: spoolItemForCreation.purchasedFrom">
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Purchased on') }}</label>
                    <div class="controls">
                        <input type="date" class="input-medium" data-bind="value: spoolItemForCreation.purchasedOnKO">
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Cost') }}</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="number" step="0.01" min="0" class="input-small text-right" data-bind="value: spoolItemForCreation.cost">
                            <span class="add-on" data-bind="text: $root.pluginSettings.currencySymbol"></span>
                        </div>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Serial number') }}</label>
                    <div class="controls">
                        <input type="text" class="input-medium" data-bind="textInput: spoolItemForCreation.code">
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Batch number') }}</label>
                    <div class="controls">
                        <input type="text" class="input-medium" data-bind="textInput: spoolItemForCreation.batchNumber">
                    </div>
                </div>
            </div>

            <!-- STEP: MISC (full only) -->
            <div data-bind="visible: currentStepId() === 'misc'">
                <div class="control-group">
                    <label class="control-label">{{ _('Auto calculation for') }}</label>
                    <div class="controls">
                        <select class="input-medium" data-bind="options: spoolItemForCreation.drivenScopeOptions,
                                                                optionsText: 'text', optionsValue: 'value',
                                                                value: spoolItemForCreation.drivenScope">
                        </select>
                        <span class="help-block"><small>{{ _('Which value the others are derived from when filament is used.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">{{ _('Note') }}</label>
                    <div class="controls">
                        <textarea rows="4" class="input-xlarge" data-bind="textInput: spoolItemForCreation.noteText"></textarea>
                        <span class="help-block"><small>{{ _('Plain text here; the spool dialog offers a formatted note editor.') }}</small></span>
                    </div>
                </div>
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: spoolItemForCreation.isTemplate"> {{ _('Use this spool as a template') }}
                        </label>
                    </div>
                </div>
            </div>

            <!-- STEP: REVIEW -->
            <div data-bind="visible: currentStepId() === 'review'">
                <table class="table table-condensed">
                    <tbody data-bind="foreach: reviewEntries">
                        <tr>
                            <td style="width: 40%;"><strong data-bind="text: label"></strong></td>
                            <td data-bind="text: value"></td>
                        </tr>
                    </tbody>
                </table>
                <div class="alert alert-error" data-bind="visible: !areMandatoryFieldsValid()">
                    {{ _('Display name, color name and total weight are required before the spool can be saved.') }}
                </div>
                <div class="alert alert-error" data-bind="visible: saveErrorMessages().length > 0">
                    <strong>{{ _('The spool could not be created:') }}</strong>
                    <ul data-bind="foreach: saveErrorMessages">
                        <li data-bind="text: $data"></li>
                    </ul>
                </div>
            </div>

            <!-- STEP: NFC -->
            <div data-bind="visible: currentStepId() === 'nfc'">
                <div class="alert alert-success">
                    {{ _('The spool was created with the database id') }} <strong data-bind="text: createdDatabaseId"></strong>.
                </div>
                <p>{{ _('Place an NFC tag on the OctoScale reader to write the spool id onto it. You can also skip this and write a tag later from the spool dialog.') }}</p>

                <div style="border-top: 1px solid rgba(128,128,128,0.35); padding-top: 10px;">
                    <div data-bind="visible: !octoScaleTagWriter.tagPresent()">
                        <i class="fas fa-spinner fa-spin"></i> {{ _('Waiting for a tag...') }}
                    </div>
                    <div data-bind="visible: octoScaleTagWriter.tagPresent">
                        <i class="fas fa-check text-success"></i> {{ _('Tag detected') }}
                        <span class="muted" data-bind="visible: octoScaleTagWriter.chipLabel">(<span data-bind="text: octoScaleTagWriter.chipLabel"></span>)</span>
                        <span class="muted" data-bind="text: octoScaleTagWriter.tagSpoolId() != null ? '(' + octoScaleTagWriter.tagSpoolId() + ')' : ''"></span>
                    </div>
                    <div class="text-warning" data-bind="visible: octoScaleTagWriter.tagPresent() && octoScaleTagWriter.hasExtendedData">
                        <i class="fas fa-info-circle"></i> {{ _('This tag already carries extended data (material/color/weights) which will be overwritten.') }}
                    </div>
                    {# Proactive TigerTag id-resolution check, see checkTigerTagResolution in
                       SpoolManager-OctoScale.js and the identical block in the edit dialog. #}
                    <div class="text-warning" data-bind="visible: octoScaleTagWriter.tigerTagResolutionWarning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span data-bind="text: octoScaleTagWriter.tigerTagResolutionWarning"></span>
                    </div>

                    <div class="alert alert-warning" style="margin-top: 8px;"
                         data-bind="visible: octoScaleTagWriter.needsOverwriteConfirmation() && !octoScaleTagWriter.overwriteConfirmed()">
                        <span data-bind="text: octoScaleTagWriter.overwriteWarningText"></span>
                        <button type="button" class="btn btn-small btn-warning" style="margin-left: 8px;"
                                data-bind="click: octoScaleTagWriter.confirmOverwrite">{{ _('Overwrite anyway') }}</button>
                    </div>

                    <!-- A manufacturer tag carries no spool id, so the id-based warning above never
                         fires for it - without this it would look exactly like a blank tag. -->
                    <div class="alert alert-error" style="margin-top: 8px;"
                         data-bind="visible: octoScaleTagWriter.isPossiblyForeignTag() && !octoScaleTagWriter.foreignTagConfirmed()">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span data-bind="text: octoScaleTagWriter.foreignTagWarningText"></span>
                        <!-- ko if: octoScaleTagWriter.vendorTagWriteEnabled -->
                        <button type="button" class="btn btn-small btn-danger" style="margin-left: 8px;"
                                data-bind="click: octoScaleTagWriter.confirmForeignTagOverwrite">{{ _('Overwrite anyway') }}</button>
                        <!-- /ko -->
                        <!-- ko ifnot: octoScaleTagWriter.vendorTagWriteEnabled -->
                        <div><small>{{ _('Writing over vendor tags is disabled in the SpoolManager settings.') }}</small></div>
                        <!-- /ko -->
                    </div>

                    <!-- Outside the warning above: reading works for any tag, including one
                         SpoolManager wrote itself. -->
                    <div style="margin-top: 8px;" data-bind="visible: octoScaleTagWriter.shouldOfferTagRead">
                        <button type="button" class="btn btn-small"
                                data-bind="click: octoScaleTagWriter.readTag, enable: octoScaleTagWriter.canReadTag">
                            <i class="fas fa-spinner fa-spin" data-bind="visible: octoScaleTagWriter.isReadingTag"></i>
                            {{ _('Read tag') }}
                        </button>
                    </div>

                    <!-- Reading takes a moment on the device, so say so rather than leaving the
                         user wondering whether the tag has to stay put. It does. -->
                    <div style="margin-top: 8px;" data-bind="visible: octoScaleTagWriter.isReadingTag">
                        <i class="fas fa-spinner fa-spin"></i>
                        <small>{{ _('Reading the tag - please leave it on the reader...') }}</small>
                    </div>
                    <div class="text-warning" style="margin-top: 8px;" data-bind="visible: octoScaleTagWriter.readTagError">
                        <i class="fas fa-info-circle"></i>
                        <span data-bind="text: octoScaleTagWriter.readTagError"></span>
                    </div>
                    <!-- ko if: octoScaleTagWriter.readTagResult() != null && octoScaleTagWriter.readTagResult().parsed === true -->
                    <!-- Read-only here on purpose: this step runs AFTER the spool has been
                         created, so there is no form left to copy the values into. It tells
                         the user what the tag holds so they can decide whether to overwrite
                         it; creating a spool from a vendor tag happens in the edit dialog. -->
                    <div class="alert alert-info" style="margin-top: 8px;">
                        <i class="fas fa-check"></i>
                        {{ _('Recognized as') }} <strong data-bind="text: octoScaleTagWriter.readTagResult().parserLabel"></strong>.
                        {{ _('This tag holds:') }}
                        <table class="table table-condensed" style="margin: 6px 0 0 0;">
                            <tbody data-bind="foreach: octoScaleTagWriter.readTagValues">
                                <tr>
                                    <td style="padding: 2px 8px 2px 0; border: none;"><small data-bind="text: label"></small></td>
                                    <td style="padding: 2px 0; border: none;"><small data-bind="text: valueText"></small></td>
                                </tr>
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-small" style="margin-top: 6px;"
                                data-bind="click: octoScaleTagWriter.clearReadTagResult">{{ _('Dismiss') }}</button>
                    </div>
                    <!-- /ko -->

                    <div style="margin-top: 10px;">
                        <button type="button" class="btn btn-primary"
                                data-bind="click: octoScaleTagWriter.writeTag, enable: octoScaleTagWriter.canWrite">
                            <i class="fas fa-spinner fa-spin" data-bind="visible: octoScaleTagWriter.isWriting"></i>
                            {{ _('Write tag') }}
                        </button>
                    </div>

                    <div class="text-success" style="margin-top: 8px;" data-bind="visible: octoScaleTagWriter.writeSucceeded">
                        <i class="fas fa-check"></i> {{ _('Tag written and verified') }}<span data-bind="visible: octoScaleTagWriter.writeFormatUsed"> (<span data-bind="text: octoScaleTagWriter.writeFormatUsed"></span>)</span>.
                        <!-- ko if: octoScaleTagWriter.writeUnsupportedFieldLabels().length > 0 -->
                        <br><small class="text-warning"><i class="fas fa-info-circle"></i>
                            {{ _('This format cannot store these values') }}:
                            <span data-bind="text: octoScaleTagWriter.writeUnsupportedFieldLabels().join(', ')"></span>.
                            {{ _('They stay in SpoolManager - a bigger tag would not help, only a different format would.') }}
                        </small>
                        <!-- /ko -->
                        <!-- ko if: octoScaleTagWriter.writeDroppedFields().length > 0 -->
                        <br><small class="text-warning"><i class="fas fa-exclamation-triangle"></i> {{ _('Some fields did not fit on the tag and were left out') }}: <span data-bind="text: octoScaleTagWriter.writeDroppedFields().join(', ')"></span></small>
                        <!-- /ko -->
                        <!-- ko if: octoScaleTagWriter.writeWarning -->
                        <br><small class="text-warning"><i class="fas fa-exclamation-triangle"></i> <span data-bind="text: octoScaleTagWriter.writeWarning"></span></small>
                        <!-- /ko -->
                        {# See the same block in SpoolManager_dialog_editSpool.jinja2 for the rationale -
                           OpenPrintTag stores no database id, so a successful write auto-teaches this
                           spool's rfidTagKey from the tag's UID. #}
                        <!-- ko if: octoScaleTagWriter.teachInResult -->
                        <!-- ko if: octoScaleTagWriter.teachInResult().taught -->
                        <br><small><i class="fas fa-id-card"></i> {{ _('Spool taught in for this tag (key') }} <span data-bind="text: octoScaleTagWriter.teachInResult().rfidTagKey"></span>).</small>
                        <!-- /ko -->
                        <!-- ko if: octoScaleTagWriter.teachInResult().reason === 'existingKeyDiffers' -->
                        <br><small class="text-warning"><i class="fas fa-exclamation-triangle"></i> {{ _('This spool already has a different tag key assigned.') }}
                        <button type="button" class="btn btn-mini btn-warning" style="margin-left: 6px;"
                                data-bind="click: octoScaleTagWriter.forceTeachRfidTagKey">{{ _('Assign anyway') }}</button></small>
                        <!-- /ko -->
                        <!-- ko if: octoScaleTagWriter.teachInResult().reason === 'collision' -->
                        <br><small class="text-warning"><i class="fas fa-exclamation-triangle"></i> {{ _("This tag's key is already assigned to") }} <span data-bind="text: octoScaleTagWriter.teachInResult().conflictingSpoolDisplayName || ('spool id ' + octoScaleTagWriter.teachInResult().conflictingSpoolId)"></span>.
                        <button type="button" class="btn btn-mini btn-warning" style="margin-left: 6px;"
                                data-bind="click: octoScaleTagWriter.forceTeachRfidTagKey">{{ _('Assign anyway') }}</button></small>
                        <!-- /ko -->
                        <!-- /ko -->
                    </div>
                    <div class="text-error" style="margin-top: 8px;" data-bind="visible: octoScaleTagWriter.errorMessage">
                        <i class="fas fa-exclamation-triangle"></i> <span data-bind="text: octoScaleTagWriter.errorMessage"></span>
                    </div>
                </div>
            </div>

        </form>
    </div>

    <div class="modal-footer">
        <span class="pull-left text-error" style="line-height: 30px;" data-bind="text: currentStepBlockReason"></span>

        <button class="btn" data-bind="click: cancelDialog, visible: currentStepId() !== 'nfc'">{{ _('Cancel') }}</button>
        <button class="btn" data-bind="click: goBack, visible: canGoBack">{{ _('Back') }}</button>
        <button class="btn btn-primary" data-bind="click: goNext, enable: canGoNext, visible: !isLastInputStep() && currentStepId() !== 'nfc'">
            {{ _('Next') }}
        </button>
        <button class="btn btn-primary" data-bind="click: saveSpool, enable: areMandatoryFieldsValid() && !isSaving(), visible: isLastInputStep">
            <i class="fas fa-spinner fa-spin" data-bind="visible: isSaving"></i>
            {{ _('Create spool') }}
        </button>
        <button class="btn" data-bind="click: skipTagWriting, visible: currentStepId() === 'nfc' && !octoScaleTagWriter.writeSucceeded()">{{ _('Skip') }}</button>
        <button class="btn btn-primary" data-bind="click: finishAfterTagWriting, visible: currentStepId() === 'nfc' && octoScaleTagWriter.writeSucceeded()">{{ _('Done') }}</button>
    </div>
</div>
