            <div class="myspan3">
                <button type="button" class="btn btn-mini spm-simplemode-toggle" style="margin-bottom: 6px;"
                        data-bind="click: spoolDialog.toggleSimpleMode,
                                   css: {'btn-info': spoolDialog.simpleMode},
                                   attr: {title: spoolDialog.simpleMode() ? 'Simple view: only basic fields are shown. Click for the full view.' : 'Full view: all fields are shown. Click for the simple view.'}">
                    <i class="fas" data-bind="css: {'fa-toggle-on': spoolDialog.simpleMode, 'fa-toggle-off': !spoolDialog.simpleMode()}"></i>
