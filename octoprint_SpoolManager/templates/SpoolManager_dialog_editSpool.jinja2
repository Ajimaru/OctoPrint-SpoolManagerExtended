                             </label>
                        </div>

                    </div>
<!-- RIGHT COLUMN -->
                    <div class="span6" >
                        <div class="">
                            <div class="row">
                                <div class="control-group  no-bottom-gap">
                                    <label class="control-label">Last use</label>
                                    <div class="controls" >
                                        <input type="datetime-local"
                                               title="Format e.g. 2022-01-12T14:36"
                                               placeholder="YYYY-MM-DDThh:mm"
                                               pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}"
                                               data-bind="value: spoolDialog.spoolItemForEditing.lastUseKO" />
                                    </div>
                                </div>
                                <div class="control-group  no-bottom-gap">
                                    <label class="control-label">First use</label>
                                    <div class="controls" >
                                        <input id="my-firstuse" type="datetime-local"
                                               title="Format e.g. 2022-01-12T14:36"
                                               placeholder="YYYY-MM-DDThh:mm"
                                               pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}"
                                               data-bind="value: spoolDialog.spoolItemForEditing.firstUseKO" />
                                    </div>
                                </div>
                                <div class="control-group  no-bottom-gap">
                                    <label class="control-label">Purchased on</label>
                                    <div class="controls" >
                                        <input type="date"
                                               title="Format e.g. 2022-01-12"
                                               placeholder="YYYY-MM-DD"
                                               pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}"
                                               data-bind="value: spoolDialog.spoolItemForEditing.purchasedOnKO" />
                                    </div>
                                </div>
