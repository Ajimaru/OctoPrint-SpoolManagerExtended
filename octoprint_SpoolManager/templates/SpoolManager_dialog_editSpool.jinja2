                                <div class="control-group no-bottom-gap">
                                    <label class="control-label">Purchased from</label>
                                    <div class="controls">
                                        <input type="text" class="input-xlarge text-left" data-bind="value: spoolDialog.spoolItemForEditing.purchasedFrom"/>
                                    </div>
                                </div>
                                <div class="control-group ">
                                    <label class="control-label">Cost</label>
                                    <div class="controls">
                                        <div class="input-append">
                                            <input type="number" step="0.01" min="0" class="input-small text-right" data-bind="value: spoolDialog.spoolItemForEditing.cost,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'cost', trackOnly: true}"/>
                                            <span class="add-on" data-bind="text: pluginSettings.currencySymbol" >€</span>
                                        </div>
                                        <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('cost') !== -1">Please enter a valid number</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Labels TODO FIXME
                            <div class="row">
                                <div class="span6 text-center">
                                    <select id="spool-labels-select" multiple="true" data-bind="options: spoolDialog.spoolItemForEditing.allLabels, selectedOptions: spoolDialog.spoolItemForEditing.labels">
                                    </select>
                                </div>
                            </div>
                            -->


                            <div class="custom-divider"></div>
                            <div>
                                <div class="control-group no-bottom-gap">
                                    <label for="driven-scope" class="control-label"><h5>Auto calculation for:</h5></label>
                                    <div class="controls">
                                        <select id="driven-scope" class="input-large"
                                                data-bind="options: spoolDialog.spoolItemForEditing.drivenScopeOptions,
                                                           value: spoolDialog.spoolItemForEditing.drivenScope,
                                                           optionsText: 'text',
                                                           optionsValue: 'value'">
                                            <option></option>
                                        </select>
                                    </div>
                                    <div style="text-align: center;">
                                        <small class="text-info" >Auto calculation prevents editing.</small>
                                    </div>
                                </div>
                                <h5>Filament Amount <small>(Without Spool)</small></h5>
                                <p data-bind="visible: !spoolDialog.areDensityAndDiameterValid()"><small class="text-error">
                                    For automatic g to mm conversions, please enter <b>Density</b> and <b>Diameter</b>!
                                </small></p>
                                <div class="control-group no-bottom-gap" >
                                    <label for="total-weight" class="control-label">Initial <sup>2</sup></label>
                                    <div class="controls">
                                        <div class="input-append">
                                            <input id="total-weight" type="number" step="any" min="0"
                                                   class="input-mini text-right"
                                                   data-bind="value: spoolDialog.totalWeightDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'totalWeight', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.FILAMENT"/>
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </div>
                                         <div class="input-append">
                                            <input type="number" step="any" min="0" class="input-small text-right"
                                                   data-bind="value: spoolDialog.totalLengthDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'totalLength', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.FILAMENT"/>
                                            <span class="add-on" data-bind="text: spoolDialog.lengthUnitText">mm</span>
                                        </div>
                                    </div>
                                    <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('totalWeight') !== -1 || spoolDialog.invalidNumberFields().indexOf('totalLength') !== -1">Please enter a valid number</span>
                                </div>
                                <div class="control-group no-bottom-gap">
                                    <label for="usedWeight" class="control-label">Used <small
                                            data-bind="visible: !isNaN(spoolDialog.spoolItemForEditing.usedPercentage())">(<span
                                            data-bind="text: spoolDialog.spoolItemForEditing.usedPercentage"></span>%)</small></label>
                                    <div class="controls">
                                        <div class="input-append">
                                            <input id="usedWeight" type="number" step="any" min="0"
                                                   class="input-mini text-right"
                                                   data-bind="value: spoolDialog.usedWeightDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'usedWeight', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.FILAMENT"/>
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </div>
                                        <span class="input-append">
                                            <input type="number" step="any" min="0" class="input-small text-right"
                                                   data-bind="value: spoolDialog.usedLengthDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'usedLength', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.FILAMENT"/>
                                            <span class="add-on" data-bind="text: spoolDialog.lengthUnitText">mm</span>
                                        </span>
                                    </div>
                                    <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('usedWeight') !== -1 || spoolDialog.invalidNumberFields().indexOf('usedLength') !== -1">Please enter a valid number</span>
                                </div>
                                <div class="control-group">
                                    <label for="remainingWeight" class="control-label">Remaining <small
                                            data-bind="visible: !isNaN(spoolDialog.spoolItemForEditing.remainingPercentage())">(<span
                                            data-bind="text: spoolDialog.spoolItemForEditing.remainingPercentage"></span>%)</small></label>
                                    <div class="controls">
                                        <span class="input-append">
                                            <input id="remainingWeight" type="number" step="any" min="0"
                                                   class="input-mini text-right"
                                                   disabled
                                                   data-bind="value: spoolDialog.remainingWeightDisplay,
                                                              disable: true"/>
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </span>
                                        <span class="input-append">
                                            <input type="number" step="any" min="0" disabled
                                                   class="input-small text-right"
                                                   data-bind="value: spoolDialog.remainingLengthDisplay,
                                                              disable: true"/>
                                            <span class="add-on" data-bind="text: spoolDialog.lengthUnitText">mm</span>
                                        </span>

                                    </div>
                                </div>
                            </div>

                            <div>
                                <h5>Spool Weight <small>(Without Filament)</small></h5>
                                <div class="control-group no-bottom-gap">
                                    <label for="spool-weight" class="control-label">Empty Spool Weight</label>
                                    <div class="controls">
                                        <div class="input-append">
                                            <input id="spool-weight" type="number" step="any" min="0"
                                                   class="input-mini text-right"
                                                   data-bind="value: spoolDialog.spoolWeightDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'spoolWeight', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.SPOOL"/>
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </div>
                                    </div>
                                    <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('spoolWeight') !== -1">Please enter a valid number</span>
                                </div>
                            </div>

                            <div>
                                <h5>Combined Weight <small>(Spool + Filament)</small></h5>
                                <div class="control-group no-bottom-gap" data-bind="css: {error: !spoolDialog.isTotalCombinedWeightPresent()}">
                                    <label class="control-label">Initial total <sup>1</sup></label>
                                    <div class="controls">
                                        <span class="input-append">
                                            <input type="number" step="any" min="0" class="input-mini text-right"
                                                   data-bind="value: spoolDialog.totalCombinedWeightDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'totalCombinedWeight', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() === spoolDialog.scopeValues.COMBINED"
                                            />
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </span>
                                    </div>
                                    <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('totalCombinedWeight') !== -1">Please enter a valid number</span>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Remaining</label>
                                    <div class="controls">
                                        <span class="input-append">
                                            <input type="number" step="any" min="0" class="input-mini text-right"
                                                    data-bind="value: spoolDialog.remainingCombinedWeightDisplay,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'remainingCombinedWeight', trackOnly: true},
                                                              disable: spoolDialog.spoolItemForEditing.drivenScope() !== spoolDialog.scopeValues.FILAMENT"
                                            />
                                            <span class="add-on" data-bind="text: spoolDialog.weightUnitText">g</span>
                                        </span>
                                    </div>
                                    <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('remainingCombinedWeight') !== -1">Please enter a valid number</span>
                                </div>
                            </div>


                            <div class="row">
                                <div class="span12 text-center">
                                    <div class="" style="margin-top:10px">
                                        <div class="">
<!--                                                <div class="spool-note-editor-container">-->
                                                <div id="spool-note-editor" style="min-height:120px;"></div>
<!--                                                </div>-->
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Image scanner -->
<!--<div class="control-group">-->
<!--                                <div class="row">-->
<!--                                    <div class="span6 text-center">-->
<!--                                         <img   src="http://localhost:5000/plugin/PrintJobHistory/static/images/janbex.png" alt=""/>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--</div>-->


                        </div>
                    </div>
            </div>
        </form>
    </div>
    <div class="modal-footer" >
        <div class="control-group">
            <div class="controls row-fluid">
                <span class="span8" style="text-align:left">

                    <button type="button" class="btn btn-danger" data-bind="visible: spoolDialog.isExistingSpool,
                                                                            disable: printerStateViewModel.isPrinting(),
                                                                            click: spoolDialog.deleteSpoolItem" >Delete</button>
                    <div data-bind="visible: printerStateViewModel.isPrinting()">
                        <small>Deletion during printing is not possible</small>
                    </div>
                    <button type="button" class="btn btn-warning" data-bind="visible: spoolDialog.isExistingSpool,
                                                                             click: spoolDialog.copySpoolItem" >Copy</button>
                    <!-- visible: spoolDialog.spoolItemForEditing.selectedFromQRCode() == true,                        -->
                    <!-- ko if: spoolDialog.spoolItemForEditing.databaseId -->
                    <select id="selectForTool" class="span2" style="margin-bottom: 0px" data-bind="optionsCaption: 'Choose...',
                                                                                value: spoolDialog.spoolItemForEditing.selectedForTool,
                                                                                options: spoolDialog.allToolIndices,
                                                                                optionsText: function(item) {
                                                                                                return 'Tool '+ item
                                                                                                }"></select>
                    <button class="btn btn-info" data-bind="enable: spoolDialog.spoolItemForEditing.selectedForTool() != undefined, click: spoolDialog.selectSpoolItemForPrinting" style="text-align:right">Select for Printing</button>
                    <!-- /ko -->

                    <button class="btn btn-info" data-bind="visible: spoolDialog.isExistingSpool()==false,
                                                            click: spoolDialog.selectAndCopyTemplateSpool" style="text-align:right">Copy from Template...</button>

                </span>
                <span class="span4 text-right">
<!--                        data-bind="click: spoolDialog.closeSpoolItemDialog"-->
                    <span class="spm-save-blocked-hint" data-bind="visible: spoolDialog.invalidNumberFields().length > 0,
                                                                    attr: {title: 'Invalid value in: ' + spoolDialog.invalidNumberFieldsLabel()}">Invalid number entered</span>
                    <button class="btn "  data-dismiss="modal"  style="text-align:right">Close</button>
                    <button class="btn btn-primary" data-bind="enable: spoolDialog.isFormValidForSubmit(), click: spoolDialog.saveSpoolItem" style="text-align:right">Save</button>
                </span>
            </div>
        </div>
    </div>
</div>

<!--###############################################################  Spool TEMPLATE SELECTION-Dialog: id="dialog_template_spool_selection" -->



<div id="dialog_template_spool_selection" class="modal hide fade-in">
    <div class="modal-header">
        <a href="#" class="close" data-dismiss="modal" aria-hidden="true">&times;</a>
        <h3>Select Template Spool</h3>
    </div>
    <div class="modal-body">
        <spm-select-spool-table params="allSpoolsKOArray: spoolDialog.templateSpools,
                                        allMaterialsKOArray: spoolDialog.allMaterials,
                                        allVendorsKOArray: spoolDialog.allVendors,
                                        allColorsKOArray: spoolDialog.allColors,
                                        selectSpoolFunction: spoolDialog.copySpoolItemFromTemplate
                                        "></spm-select-spool-table>
    </div>
    <div class="modal-footer">
        <a href="#" class="btn" data-dismiss="modal" aria-hidden="true">Close</a>
    </div>
</div>

