    <div class="modal-body hack-flowbreak"  >
        <form  class="form-horizontal" id="spool-form" >
            <input type="hidden" data-bind="value: spoolDialog.spoolItemForEditing.version" />
            <div class="row-fluid " >
<!-- LEFT COLUMN -->

                    <div class="span6" >
                        <div class="control-group" data-bind="css: {error: !spoolDialog.isDisplayNamePresent()}">
                            <label class="control-label">Displayname <sup>1</sup></label>
                            <div class="controls">
                                <div class="spm-template-combo">
                                    <input data-bind="textInput: spoolDialog.spoolItemForEditing.displayName,
                                                      event: { focus: spoolDialog.onDisplayNameFocus, blur: spoolDialog.onDisplayNameBlur }"
                                           type="text" class="input-large" autocomplete="off" />
                                    <span class="spm-template-combo-caret" title="Select a template"
                                          data-bind="visible: spoolDialog.isTemplateComboAvailable,
                                                     event: { mousedown: spoolDialog.toggleTemplateCombo }"><i class="fas fa-caret-down"></i></span>
                                    <ul class="spm-template-combo-list" data-bind="visible: spoolDialog.templateComboVisible">
                                        <!-- ko foreach: spoolDialog.filteredTemplateSpools -->
                                        <li data-bind="event: { mousedown: function(){ $parent.spoolDialog.selectTemplateFromCombo($data); return false; } }">
                                            <span class="color-preview" data-bind="style: {'background': spmSpoolColorCss(color)}"></span>
                                            <span data-bind="text: displayName"></span>
                                            <span class="spm-template-combo-meta"><span data-bind="text: material"></span> <span data-bind="text: vendor"></span></span>
                                        </li>
                                        <!-- /ko -->
                                        <li class="spm-template-combo-empty" data-bind="visible: spoolDialog.filteredTemplateSpools().length == 0">No matching template</li>
                                    </ul>
                                </div>
                                <span class="help-inline" style="cursor: help;"
                                      title="Template names can contain variables that are filled in when a spool is created from the template:
{material}, {color}, {vendor}, {diameter}, {weight}, {code}, {batch} and {id}.
{id} is replaced with the database id when the spool is saved.
Example: {material}-{color}-{id} becomes PETG-Silver-42."><i class="fas fa-info-circle"></i></span>
                                <span class="help-block" style="margin-bottom: 0;"
                                      data-bind="visible: spoolDialog.displayNamePreview().length > 0">
                                    Resulting name: <strong data-bind="text: spoolDialog.displayNamePreview"></strong>
                                </span>
                            </div>
                        </div>
                        <div class="control-group" data-bind="css: {error: !spoolDialog.isColorNamePresent()}">
                            <label class="control-label">Color <sup>1</sup></label>
                            <div class="row controls">
                                <input data-bind="textInput: spoolDialog.spoolItemForEditing.colorName"  type="text" class="input-small"  /><span class="color-preview" style="margin-bottom: -5px; cursor: default;" data-bind="style: {'background': spmSpoolColorCss(spoolDialog.spoolItemForEditing.color)}"></span>
                            </div>
                            <div class="row controls" style="margin-top: 4px;" data-bind="visible: !spoolDialog.spoolItemForEditing.isRainbow()">
                                {# Containers only - the color picker component renders itself into
                                   them (see common/colorPicker.js, wired up in SpoolItem). #}
                                <span id="filament-color-picker"></span>
                                <span data-bind="visible: spoolDialog.spoolItemForEditing.colorCount() >= 2">
                                    <span id="filament-color-picker2"></span>
                                </span>
                                <span data-bind="visible: spoolDialog.spoolItemForEditing.colorCount() >= 3">
                                    <span id="filament-color-picker3"></span>
                                </span>
                                <a href="#" class="btn btn-mini" title="Add a color (multi-color spool)"
                                   data-bind="click: spoolDialog.addColorClicked, visible: spoolDialog.spoolItemForEditing.colorCount() < 3"><i class="fas fa-plus"></i></a>
                                <a href="#" class="btn btn-mini" title="Remove last color"
                                   data-bind="click: spoolDialog.removeColorClicked, visible: spoolDialog.spoolItemForEditing.colorCount() > 1"><i class="fas fa-minus"></i></a>
                            </div>
                            {# "Rainbow" is a fixed rainbow gradient with no colors of its own, which
                               is why the pickers above are hidden while it is active. Multi-color
                               spools are made with the "+" button next to the pickers instead. #}
                            <div class="row controls">
                                <label class="checkbox">
                                    <input type="checkbox" data-bind="checked: spoolDialog.spoolItemForEditing.isRainbow"> Rainbow (preset gradient)
                                </label>
                                <label class="checkbox">
                                    <input type="checkbox" data-bind="checked: spoolDialog.spoolItemForEditing.isTransparent"> Transparent / translucent
                                </label>
                                {# Same option the Add Spool Wizard offers. It used to be reachable
                                   only through pick-a-color's "translucent" swatch, which is gone
                                   along with the widget. #}
                                <label class="checkbox" style="margin-left: 20px;"
                                       data-bind="visible: spoolDialog.spoolItemForEditing.isTransparent">
                                    <input type="checkbox" data-bind="checked: spoolDialog.spoolItemForEditing.transparentUntinted"> completely colorless (no base color)
                                </label>
                                <span class="help-block" style="margin-bottom: 0;" data-bind="visible: spoolDialog.spoolItemForEditing.isRainbow">
                                    <small>Rainbow uses a fixed gradient. For your own multi-color spool, uncheck this and add colors with <i class="fas fa-plus"></i>.</small>
                                </span>
                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Vendor</label>
                            <div class="controls">
                                {# Free text stays available; the grouped dropdown distinguishes local and
                                   SpoolmanDB suggestions without making group labels selectable. #}
                                <div class="input-append dropdown">
                                     <input id="spool-vendor-select" type="text" class="input-large"
                                         list="spool-vendor-list"
                                           autocomplete="off" placeholder="Choose or type..."
                                           data-bind="textInput: spoolDialog.spoolItemForEditing.vendor">
                                     <datalist id="spool-vendor-list" data-bind="foreach: spoolDialog.allVendors">
                                         <option data-bind="attr: { value: $data }"></option>
                                     </datalist>
                                    <button class="btn dropdown-toggle" type="button" data-toggle="dropdown"
                                            title="Choose vendor" aria-label="Choose vendor">
                                        <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu spm-vendor-menu">
                                        <!-- ko if: spoolDialog.userVendors().length -->
                                        <li class="nav-header">Your vendors</li>
                                        <!-- ko foreach: spoolDialog.userVendors -->
                                        <li><a href="#" data-bind="text: $data, click: $root.spoolDialog.selectVendor"></a></li>
                                        <!-- /ko -->
                                        <!-- /ko -->
                                        <!-- ko if: spoolDialog.spoolmanDbVendors().length -->
                                        <li class="divider"></li>
                                        <li class="nav-header">SpoolmanDB vendors</li>
                                        <!-- ko foreach: spoolDialog.spoolmanDbVendors -->
                                        <li><a href="#" data-bind="text: $data, click: $root.spoolDialog.selectVendor"></a></li>
                                        <!-- /ko -->
                                        <!-- /ko -->
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="control-group no-bottom-gap">
                            <label class="control-label">Material</label>
                            <div class="controls">
                                <input id="spool-material-select" type="text" class="input-large" list="spool-material-list"
                                       autocomplete="off" placeholder="Choose or type..."
                                       data-bind="textInput: spoolDialog.spoolItemForEditing.material">
                                <datalist id="spool-material-list" data-bind="foreach: spoolDialog.allMaterials">
                                    <option data-bind="attr: { value: $data }"></option>
                                </datalist>
                            </div>
                        </div>
                        <div class="control-group no-bottom-gap" data-bind="visible: spoolDialog.spoolmanProducts().length || spoolDialog.spoolmanLoading()">
                            <label class="control-label">SpoolmanDB product</label>
                            <div class="controls">
                                <select class="input-large" data-bind="options: spoolDialog.spoolmanProducts,
                                                                        optionsText: 'name',
                                                                        value: spoolDialog.selectedSpoolmanProduct,
                                                                        optionsCaption: spoolDialog.spoolmanLoading() ? 'Loading...' : 'Choose...',
                                                                        enable: !spoolDialog.spoolmanLoading() && !spoolDialog.isU1RfidFlow()"></select>
                                <span class="help-block" data-bind="visible: spoolDialog.isU1RfidFlow"><small>Disabled - this spool is prefilled from its RFID tag, which knows the exact values for this physical spool. Picking a catalog product here would overwrite them with generic ones.</small></span>
                                <span class="help-block" data-bind="visible: !spoolDialog.isU1RfidFlow() && spoolDialog.selectedSpoolmanProduct() && spoolDialog.selectedSpoolmanProduct().ambiguous"><small>Multiple temperature variants exist; no temperature is prefilled.</small></span>
                            </div>
                        </div>
                        <div class="control-group no-bottom-gap">
                            <label class="control-label">Density <sup>2,3</sup></label>
                            <div class="controls">
                                <div class="input-append">
                                    <input type="number" step="0.001" min="0" class="input-small text-right" data-bind="value: spoolDialog.spoolItemForEditing.density,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'density', trackOnly: true}" />
                                    <span class="add-on">g/cm³</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('density') !== -1">Please enter a valid number</span>
                            </div>
                        </div>
                        <div class="control-group ">
                            <label class="control-label">Diameter <sup>2</sup></label>
                            <div class="controls">
                                <div class="input-append">
                                    <input type="number" step="0.001" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.diameter,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'diameter', trackOnly: true}" />
                                    <span class="add-on">mm</span>
                                </div>
                                <div class="input-prepend input-append">
                                    <span class="add-on">±</span>
                                    <input type="number" step="0.001" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.diameterTolerance,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'diameterTolerance', trackOnly: true}" />
                                    <span class="add-on">mm</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('diameter') !== -1 || spoolDialog.invalidNumberFields().indexOf('diameterTolerance') !== -1">Please enter a valid number</span>
                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Finish</label>
                            <div class="controls">
                                <select class="input-medium" data-bind="options: spoolDialog.finishOptions,
                                                                        optionsText: 'text', optionsValue: 'value',
                                                                        optionsCaption: '',
                                                                        value: spoolDialog.spoolItemForEditing.finishSelection">
                                </select>
                                <input type="text" class="input-medium" placeholder="Custom finish"
                                       data-bind="visible: spoolDialog.spoolItemForEditing.finishSelection() === 'custom',
                                                  textInput: spoolDialog.spoolItemForEditing.finishCustomText" />
                            </div>
                        </div>
                        {# Preview-Label button, simple view only (full view: QR-code thumbnail is the link).
                           Idea from mdziekon#54 / dojohnso#59 (ScottGibb), reimplemented #}
                        <div class="control-group" style="margin-top: 12px;" data-bind="visible: spoolDialog.simpleMode() && spoolDialog.isExistingSpool() && pluginSettings.qrCodeEnabled()">
                            <label class="control-label">QR Label</label>
                            <div class="controls">
                                <a class="btn btn-small" target="_new"
                                   data-bind="attr: $root.generateQRCodeImageSourceAttribute(spoolDialog.spoolItemForEditing.databaseId(),
                                                                                             spoolDialog.spoolItemForEditing.displayName(),
                                                                                             'htmlView')">Preview Label</a>
                            </div>
                        </div>
                        <div class="control-group no-bottom-gap" data-bind="visible: !spoolDialog.simpleMode()">
                            <label class="control-label">Flow Rate Compensation<sup>4</sup></label>
                            <div class="controls">
                                <div class="input-append">
                                    <input type="number" step="1" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.flowRateCompensation,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'flowRateCompensation', trackOnly: true}" />
                                    <span class="add-on">%</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('flowRateCompensation') !== -1">Please enter a valid number</span>
                            </div>
                        </div>

                        <div class="control-group no-bottom-gap" data-bind="visible: !spoolDialog.simpleMode()">
                            <label class="control-label">Tool/Bed<sup>4</sup></label>
                            <div class="row controls">
                                <div class="input-append">
                                    <input type="number" step="1" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.temperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'temperature', trackOnly: true}" />
                                    <span class="add-on">°C</span>
{#                                    </div>#}
{##}
{#                                    <span>&nbsp;Bed</span>#}
{#                                    <div class="input-append">#}
                                    <input type="number" step="1" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.bedTemperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'bedTemperature', trackOnly: true}" />
                                    <span class="add-on">°C</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('temperature') !== -1 || spoolDialog.invalidNumberFields().indexOf('bedTemperature') !== -1">Please enter a valid number</span>
                                <span class="help-inline">Effective: <span data-bind="text: spoolDialog.spoolItemForEditing.absoluteTemperature"></span> / <span data-bind="text: spoolDialog.spoolItemForEditing.absoluteBedTemperature"></span> °C</span>
                            </div>
                        </div>
                        <div class="control-group " data-bind="visible: !spoolDialog.simpleMode()">
                            <label class="control-label">Enclosure</label>
                            <div class="controls">
                                <div class="input-append">
                                    <input type="number" step="1" min="0" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.enclosureTemperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'enclosureTemperature', trackOnly: true}" />
                                    <span class="add-on">°C</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('enclosureTemperature') !== -1">Please enter a valid number</span>
                            </div>
                        </div>

                        <div class="control-group no-bottom-gap" data-bind="visible: !spoolDialog.simpleMode()">
                            <label class="control-label">Offset Tool/Bed<sup>5</sup></label>
                            <div class="row controls">
                                <div class="input-append">
                                    <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.offsetTemperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'offsetTemperature', trackOnly: true}" />
                                    <span class="add-on">°C</span>
{#                                    </div>#}
{##}
{#                                    <span>&nbsp;Offset Bed<sup>5</sup></span>#}
{#                                    <div class="input-append">#}
                                    <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.offsetBedTemperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'offsetBedTemperature', trackOnly: true}" />
                                    <span class="add-on">°C</span>
                                </div>
                                <span class="spm-number-invalid-hint" data-bind="visible: spoolDialog.invalidNumberFields().indexOf('offsetTemperature') !== -1 || spoolDialog.invalidNumberFields().indexOf('offsetBedTemperature') !== -1">Please enter a valid number</span>
                            </div>
                        </div>
                        <div class="control-group " data-bind="visible: !spoolDialog.simpleMode()">
                            <label class="control-label">Offset Enclosure<sup>5</sup></label>
                            <div class="controls">
                                <div class="input-append">
                                    <input type="number" step="1" class="input-mini text-right" data-bind="value: spoolDialog.spoolItemForEditing.offsetEnclosureTemperature,
                                                              numberField: {invalidFields: spoolDialog.invalidNumberFields, key: 'offsetEnclosureTemperature', trackOnly: true}" />
