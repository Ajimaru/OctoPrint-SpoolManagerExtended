                                    class="dropdown-menu"
                                    data-bind="foreach: spoolDialog.allToolIndices"
                                >
                                    <li>
                                        <a
                                            tabindex="-1"
                                            href="#"
                                            data-bind="click: function () { $parent.spoolDialog.selectSpoolItemForPrintingOnTool({ toolIdx: $data }); }"
                                        >
                                            Tool #<span data-bind="text: $data"></span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        <!-- /ko -->
                        <!-- ko if: spoolDialog.allToolIndices().length == 1 -->
                            <button
                                class="btn btn-info"
                                type="button"
                                data-bind="click: function () { spoolDialog.selectSpoolItemForPrintingOnTool({ toolIdx: spoolDialog.allToolIndices()[0] }); },
                                           enable: !spoolDialog.spoolItemForEditing.selectedFromQRCode()"
                            >
                                <i class="fa fa-print"></i> Select for printing (tool #<span data-bind="text: spoolDialog.allToolIndices()[0]"></span>)
                            </button>
                        <!-- /ko -->
                    <!-- /ko -->
                    <button class="btn btn-info" data-bind="visible: spoolDialog.isExistingSpool()==false,
                                                            click: spoolDialog.selectAndCopyTemplateSpool" style="text-align:right">Copy from Template...</button>

                    <div data-bind="visible: printerStateViewModel.isPrinting()" class="muted" style="margin-top: 10px;">
                        <small>Deletion during printing is not possible</small>
                    </div>
                    <div data-bind="visible: spoolDialog.isLoadedInTool() &amp;&amp; !printerStateViewModel.isPrinting()" class="muted" style="margin-top: 10px;">
                        <small>Spool is loaded into a tool and cannot be deleted</small>
                    </div>
                    <div data-bind="visible: spoolDialog.spoolItemForEditing.selectedFromQRCode()" class="muted" style="margin-top: 10px;">
                        <small>Already selected via QR code</small>
                    </div>

                </span>
                <span class="span4 text-right">
<!--                        data-bind="click: spoolDialog.closeSpoolItemDialog"-->
                    <span class="spm-save-blocked-hint" data-bind="visible: spoolDialog.invalidNumberFields().length > 0,
                                                                    attr: {title: 'Invalid value in: ' + spoolDialog.invalidNumberFieldsLabel()}">Invalid number entered</span>
                    <button type="button" class="btn" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" data-bind="enable: spoolDialog.isFormValidForSubmit(), click: spoolDialog.saveSpoolItem">Save</button>
                </span>
            </div>
        </div>
    </div>
</div>

<!--###############################################################  Spool TEMPLATE SELECTION-Dialog: id="dialog_template_spool_selection" -->



<div id="dialog_template_spool_selection" class="modal hide fade">
    <div class="modal-header">
        <a href="#" class="close" data-dismiss="modal" aria-hidden="true">&times;</a>
        <h3 class="modal-title">Select Template Spool</h3>
    </div>
    <div class="modal-body">
        <spm-select-spool-table params="allSpoolsKOArray: spoolDialog.templateSpools,
                                        allMaterialsKOArray: spoolDialog.allMaterials,
                                        allVendorsKOArray: spoolDialog.allVendors,
                                        allColorsKOArray: spoolDialog.allColors,
                                        selectSpoolFunction: spoolDialog.copySpoolItemFromTemplate
                                        "></spm-select-spool-table>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
    </div>
</div>

<!--###############################################################  Simple-View warning: id="dialog_simplemode_warning" -->
<div id="dialog_simplemode_warning" class="modal hide fade">
    <div class="modal-header">
        <a href="#" class="close" data-dismiss="modal" aria-hidden="true">&times;</a>
        <h3 class="modal-title"><i class="fas fa-exclamation-triangle spm-dialog-icon-warning"></i>&nbsp; Hidden fields in Simple view</h3>
    </div>
    <div class="modal-body">
        <p>This template contains data in fields that are <strong>not shown</strong> in the Simple view:</p>
        <ul data-bind="foreach: spoolDialog.simpleModeHiddenFieldsWithData">
            <li data-bind="text: $data"></li>
        </ul>
        <p><small class="text-info">The data is kept and saved either way &mdash; switching to the Full view only makes these fields visible so you can review or edit them.</small></p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn" data-bind="click: spoolDialog.stayInSimpleViewFromWarning">Stay in Simple view</button>
        <button type="button" class="btn btn-primary" data-bind="click: spoolDialog.switchToFullViewFromWarning">Switch to Full view</button>
    </div>
</div>
